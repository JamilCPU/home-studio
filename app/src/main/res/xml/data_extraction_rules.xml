<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the server address out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/home_studio_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/home_studio_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
